###  https://w3id.org/emmo#Arcminute
ns1:Arcminute rdf:type owl:Class ;
              rdfs:subClassOf ns1:EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac ,
                              ns1:EMMO_be8680e5_28ec_4168_9206_d1cd33fbd458 ,
                              ns1:EMMO_cdc962d8_f3ea_4764_a57a_c7caa4859179 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                owl:hasValue "2.908882E-4"^^xsd:double
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                owl:hasValue "0.0"^^xsd:double
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                                owl:hasValue "′"
                              ] ;
              rdfs:comment """A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or π /10,800 radians. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation.

-- QUDT"""@en ;
              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#> ,
                               "http://qudt.org/2.1/vocab/unit" ;
              rdfs:label "Arcminute"@en ;
              skos:altLabel "ArcMinute"@en ,
                            "MinuteOfArc"@en ;
              skos:prefLabel "Arcminute"@en ;
              schema:unitCode "D61" ;
              ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/ARCMIN" ;
              ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "'" ;
              ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "'" ;
              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or π /10,800 radians. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation.

-- QUDT"""@en ;
              ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Minute_of_arc" .


###  https://w3id.org/emmo#Arcsecond
ns1:Arcsecond rdf:type owl:Class ;
              rdfs:subClassOf ns1:EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac ,
                              ns1:EMMO_be8680e5_28ec_4168_9206_d1cd33fbd458 ,
                              ns1:EMMO_cdc962d8_f3ea_4764_a57a_c7caa4859179 ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                owl:hasValue "4.848137E-6"^^xsd:double
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                owl:hasValue "0.0"^^xsd:double
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                                owl:hasValue "″"
                              ] ;
              rdfs:comment """\"Arc Second\" is a unit of angular measure, also called the `second of arc`, equal to 1/60 arcminute. One arcsecond is a very small angle: there are 1,296,000 in a circle. The SI recommends `double prime` ('') as the symbol for the arcsecond. The symbol has become common in astronomy, where very small angles are stated in milliarcseconds (mas).

-- QUDT"""@en ;
              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#> ,
                               "http://qudt.org/2.1/vocab/unit" ;
              rdfs:label "Arcsecond"@en ;
              skos:altLabel "ArcSecond"@en ,
                            "SecondOfArc"@en ;
              skos:prefLabel "Arcsecond"@en ;
              schema:unitCode "D62" ;
              ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/ARCSEC" ;
              ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "''" ;
              ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "\\\"" ;
              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """\"Arc Second\" is a unit of angular measure, also called the `second of arc`, equal to 1/60 arcminute. One arcsecond is a very small angle: there are 1,296,000 in a circle. The SI recommends `double prime` ('') as the symbol for the arcsecond. The symbol has become common in astronomy, where very small angles are stated in milliarcseconds (mas).

-- QUDT"""@en ;
              ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Minute_of_arc#Symbols.2C_abbreviations_and_subdivisions" .


###  https://w3id.org/emmo#AstronomicalUnit
ns1:AstronomicalUnit rdf:type owl:Class ;
                     rdfs:subClassOf ns1:EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3 ,
                                     ns1:EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45 ,
                                     ns1:EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac ,
                                     ns1:EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a ,
                                     ns1:EMMO_b3600e73_3e05_479d_9714_c041c3acf5cc ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                       owl:hasValue "1.495979E11"^^xsd:double
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                                       owl:hasValue "au"
                                     ] ;
                     rdfs:comment """An astronomical unit (abbreviated as AU, au, a.u., or ua) is a unit of length equal to 149,597,870,700 metres (92,955,807.273 mi) or approximately the mean Earth Sun distance. The symbol ua is recommended by the International Bureau of Weights and Measures, and the international standard ISO 80000, while au is recommended by the International Astronomical Union, and is more common in Anglosphere countries. In general, the International System of Units only uses capital letters for the symbols of units which are named after individual scientists, while au or a.u. can also mean atomic unit or even arbitrary unit. However, the use of AU to refer to the astronomical unit is widespread. The astronomical constant whose value is one astronomical unit is referred to as unit distance and is given the symbol A. [Wikipedia]

-- QUDT"""@en ,
                                  "One astronomical unit is defined as exactly 149597870700 m, which is roughly the distance from earth to sun."@en ;
                     rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#> ;
                     rdfs:label "AstronomicalUnit"@en ;
                     skos:altLabel "astronomical-unit"@en ;
                     skos:prefLabel "AstronomicalUnit"@en ;
                     schema:unitCode "A12" ;
                     ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "https://qudt.org/vocab/unit/AU" ;
                     ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "AU" ;
                     ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/page/Astronomical_unit" ;
                     ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "One astronomical unit is defined as exactly 149597870700 m, which is roughly the distance from earth to sun."@en ;
                     ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "AU" ,
                                                                   "au" ;
                     ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """An astronomical unit (abbreviated as AU, au, a.u., or ua) is a unit of length equal to 149,597,870,700 metres (92,955,807.273 mi) or approximately the mean Earth Sun distance. The symbol ua is recommended by the International Bureau of Weights and Measures, and the international standard ISO 80000, while au is recommended by the International Astronomical Union, and is more common in Anglosphere countries. In general, the International System of Units only uses capital letters for the symbols of units which are named after individual scientists, while au or a.u. can also mean atomic unit or even arbitrary unit. However, the use of AU to refer to the astronomical unit is widespread. The astronomical constant whose value is one astronomical unit is referred to as unit distance and is given the symbol A. [Wikipedia]

-- QUDT"""@en ;
                     ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Astronomical_unit"^^xsd:anyURI .


