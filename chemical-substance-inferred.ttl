###  https://w3id.org/emmo#EMMO_ad0e72fc_dcaa_490d_8371_b4d814dcda2c
ns1:EMMO_ad0e72fc_dcaa_490d_8371_b4d814dcda2c rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf ns1:EMMO_ec2472ae_cf4a_46a5_8555_1556f5a6c3c5 ;
                                              rdfs:comment """Causality is the fundamental concept describing how entities affect each other, and conceptually precedes time and space relations. In the EMMO causality is the foundation for space and time relations.
Embracing a strong reductionistic view, causality originates at quantum entities level, meaning that causal relations between macroscopic entities is simply the sum of quantum level causality relations."""@en ,
                                                           "The superclass of all causal EMMO relations."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/mereocausality#> ;
                                              rdfs:label "causal"@en ;
                                              skos:prefLabel "causal"@en ;
                                              ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 """Causality is the fundamental concept describing how entities affect each other, and conceptually precedes time and space relations. In the EMMO causality is the foundation for space and time relations.
Embracing a strong reductionistic view, causality originates at quantum entities level, meaning that causal relations between macroscopic entities is simply the sum of quantum level causality relations."""@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The superclass of all causal EMMO relations."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Causality in the EMMO is intended as physical causation and not counter-factual. Meaning that causality is an expression of actual physical interactions, and not of a counterfactual depence such as “I didn't water the flowers, hence, I'm the cause of their death”."@en ,
                                                                                            "Each pair of entities is either in isCauseOf or isNotCauseOf relation. The two are mutually exclusive."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_ad0e72fc_dcaa_490d_8371_b4d814dcda2c ;
   owl:annotatedProperty ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 ;
   owl:annotatedTarget """Causality is the fundamental concept describing how entities affect each other, and conceptually precedes time and space relations. In the EMMO causality is the foundation for space and time relations.
Embracing a strong reductionistic view, causality originates at quantum entities level, meaning that causal relations between macroscopic entities is simply the sum of quantum level causality relations."""@en ;
   rdfs:seeAlso ns1:EMMO_3f9ae00e_810c_4518_aec2_7200e424cf68 ,
                "doi:10.3233/FAIA231120"
 ] .


###  https://w3id.org/emmo#EMMO_ae2d1a96_bfa1_409a_a7d2_03d69e8a125a
ns1:EMMO_ae2d1a96_bfa1_409a_a7d2_03d69e8a125a rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf ns1:EMMO_9a50a0ae_841a_46fe_8b23_3df319b60611 ;
                                              rdfs:domain ns1:EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce ;
                                              rdfs:range ns1:EMMO_13191289_6c2b_4741_93e1_82d53bd0e703 ;
                                              rdfs:comment """Participation is a parthood relation: you must be part of the process to contribute to it. A participant whose 4D extension is totally contained within the process.

Participation is not under direct parthood since a process is not strictly related to reductionism, but it's a way to categorise temporal regions by the interpreters."""@en ,
                                                           "The relation between a process and an object participating to it, i.e. that is relevant to the process itself."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
                                              rdfs:label "hasParticipant"@en ;
                                              skos:prefLabel "hasParticipant"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The relation between a process and an object participating to it, i.e. that is relevant to the process itself."@en .


