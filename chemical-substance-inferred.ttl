###  https://w3id.org/emmo#EMMO_0342678c_13ba_43d7_9cbd_df60967a0a45
ns1:EMMO_0342678c_13ba_43d7_9cbd_df60967a0a45 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_03441eb3_d1fd_4906_b953_b83312d7589e ;
