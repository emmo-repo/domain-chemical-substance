                               owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                               owl:hasValue "kg"
                             ] ;
             rdfs:comment "The kilogram, symbol kg, is the SI unit of mass. It is defined by taking the fixed numerical value of the Planck constant h to be 6.62607015×10−34 when expressed in the unit J s, which is equal to kg m2 s−1, where the metre and the second are defined in terms of c and ∆νCs."@en ;
             rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
             rdfs:label "Kilogram"@en ;
             skos:altLabel "Kilogram"@en ;
             skos:prefLabel "Kilogram"@en ;
             schema:unitCode "KGM" ;
             ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/KiloGM" ;
             ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "kg" ;
             ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/resource/Kilogram"^^xsd:anyURI ;
             ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "The kilogram, symbol kg, is the SI unit of mass. It is defined by taking the fixed numerical value of the Planck constant h to be 6.62607015×10−34 when expressed in the unit J s, which is equal to kg m2 s−1, where the metre and the second are defined in terms of c and ∆νCs."@en ;
             ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Kilogram?oldid=493633626"^^xsd:anyURI ;
             ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.K03391" .


