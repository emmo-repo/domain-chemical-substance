###  https://w3id.org/emmo#Tesla
ns1:Tesla rdf:type owl:Class ;
          rdfs:subClassOf ns1:EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3 ,
                          ns1:EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45 ,
                          ns1:EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a ,
                          ns1:EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b ,
                          ns1:EMMO_ec903946_ddc9_464a_903c_7373e0d1eeb5 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                            owl:hasValue "T"
                          ] ;
          rdfs:comment "SI unit for magnetic flux density or induction."@en ;
          rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
          rdfs:label "Tesla"@en ;
          skos:prefLabel "Tesla"@en ;
          schema:unitCode "D33" ;
          ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/T" ;
          ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "T" ;
          ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/resource/Tesla"^^xsd:anyURI ;
          ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "SI unit for magnetic flux density or induction."@en ;
          ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """The SI unit of flux density (or field intensity) for magnetic fields (also called the magnetic induction). The intensity of a magnetic field can be measured by placing a current-carrying conductor in the field. The magnetic field exerts a force on the conductor, a force which depends on the amount of the current and on the length of the conductor. One tesla is defined as the field intensity generating one newton of force per ampere of current per meter of conductor. Equivalently, one tesla represents a magnetic flux density of one weber per square meter of area. A field of one tesla is quite strong: the strongest fields available in laboratories are about 20 teslas, and the Earth's magnetic flux density, at its surface, is about 50 microteslas. The tesla, defined in 1958, honors the Serbian-American electrical engineer Nikola Tesla (1856-1943), whose work in electromagnetic induction led to the first practical generators and motors using alternating current.

-- QUDT"""@en ,
                                                        "T = V·s·m⁻² = N/(A·m) = Wb/m²" ;
          ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Tesla_(unit)"^^xsd:anyURI ;
          ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.T06283" .


