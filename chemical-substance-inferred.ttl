                                  owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                  owl:hasValue "1.0"^^xsd:double
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                  owl:hasValue "0.0"^^xsd:double
                                ] ;
                rdfs:comment """The joule-second is a unit equal to a joule multiplied by a second, used to measure action or angular momentum. The joule-second is the unit used for Planck's constant.

-- QUDT"""@en ;
                rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits#> ,
                                 "http://qudt.org/2.1/vocab/unit" ;
                rdfs:label "JouleSecond"@en ;
                skos:altLabel "Joule Second"@en ;
                skos:prefLabel "JouleSecond"@en ;
                ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/J-SEC" ;
                ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "J.s" ;
                ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "J⋅s" ;
                ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """The joule-second is a unit equal to a joule multiplied by a second, used to measure action or angular momentum. The joule-second is the unit used for Planck's constant.

-- QUDT"""@en .


