[ ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Enforcing the fact that an entity cannot cause itself."@en ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate ns1:EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf ;
                           swrl:argument1 <urn:swrl:var#x>
                         ] ;
               rdf:rest rdf:nil
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate ns1:EMMO_01e5766d_dac3_4574_8a78_310de92a5c9d ;
                           swrl:argument1 <urn:swrl:var#x> ;
                           swrl:argument2 <urn:swrl:var#x>
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

