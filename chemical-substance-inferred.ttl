                                              ns1:EMMO_3f9ae00e_810c_4518_aec2_7200e424cf68
                                            )
                              ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360 ;
