   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "CausalPath"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Ancient Greek πάτος (pátos, “path”)."@en
 ] .


