###  https://w3id.org/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652
ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 rdf:type owl:AnnotationProperty ;
                                              rdfs:comment "Unified Code for Units of Measure (UCUM)."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/metrology#> ;
                                              rdfs:label "ucumCode"@en ;
                                              rdfs:seeAlso "https://ucum.org/"^^xsd:anyURI ;
                                              skos:prefLabel "ucumCode"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Unified Code for Units of Measure (UCUM)."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "The Unified Code for Units of Measure (UCUM) is a code system intended to include all units of measures being contemporarily used in international science, engineering, and business. The purpose is to facilitate unambiguous electronic communication of quantities together with their units."@en ;
                                              rdfs:subPropertyOf ns1:EMMO_58e7c821_4af0_4394_89f7_a9649735f4d2 ;
                                              rdfs:range xsd:string ;
                                              rdfs:domain ns1:EMMO_b081b346_7279_46ef_9a3d_2c088fcd79f4 .


