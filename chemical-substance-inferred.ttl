   owl:annotatedTarget _:genid1073 ;
   ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Every entity is made of quantum parts. This axiomatisation is the expression of the radical reductionistic approach of the EMMO."@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1075 ;
   ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "All EMMO individuals are part of the most comprehensive entity which is the universe."@en
 ] .

[ rdf:type owl:Axiom ;
