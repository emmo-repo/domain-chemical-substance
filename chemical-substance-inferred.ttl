###  https://w3id.org/emmo#EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172
ns1:EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_057e7d57_aff0_49de_911a_8861d85cef40 ;
                                              rdfs:comment "A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data."@en ,
                                                           "The class for entities which stands for a specific data format expressed using a symbolic encoding."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/computerscience#> ;
                                              rdfs:label "SymbolicData"@en ;
                                              rdfs:seeAlso "https://www.w3.org/TR/2012/REC-xmlschema11-2-20120405/#built-in-datatypes"^^xsd:anyURI ,
                                                           "https://www.w3.org/TR/rdf11-concepts/"^^xsd:anyURI ,
                                                           "https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Datatype_Maps" ,
                                                           "https://www.w3schools.com/xml/schema_dtypes_numeric.asp" ;
                                              skos:altLabel "LiteralData" ;
                                              skos:prefLabel "SymbolicData"@en ;
                                              ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 "A symbolic data is a data that is rooted on some specified symbolic based encoding, such as floating point numbers, strings, integer. When a symbolic data is used for expressing numerical data (e.g., integer), it is not to be intended as a mathematical entity (even if it may be interpreted as such) but as a syntactic structure (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data."@en ;
                                              ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db "DisjointUnionOf: ArrayData, ScalarData" ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The class for entities which stands for a specific data format expressed using a symbolic encoding."@en .


