###  https://w3id.org/emmo#Ampere
ns1:Ampere rdf:type owl:Class ;
           rdfs:subClassOf ns1:EMMO_3a185e6c_9e19_4776_b583_19c978156aa0 ,
                           ns1:EMMO_d5f3e0e5_fc7d_4e64_86ad_555e74aaff84 ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                             owl:hasValue "A"
                           ] ;
           rdfs:comment "The ampere, symbol A, is the SI unit of electric current. It is defined by taking the fixed numerical value of the elementary charge e to be 1.602176634×10−19 when expressed in the unit C, which is equal to A s, where the second is defined in terms of ∆νCs."@en ;
           rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
           rdfs:label "Ampere"@en ;
           skos:prefLabel "Ampere"@en ;
           schema:unitCode "AMP" ;
           ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/A" ;
           ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "A" ;
           ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/resource/Ampere"^^xsd:anyURI ;
           ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "The ampere, symbol A, is the SI unit of electric current. It is defined by taking the fixed numerical value of the elementary charge e to be 1.602176634×10−19 when expressed in the unit C, which is equal to A s, where the second is defined in terms of ∆νCs."@en ;
           ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Ampere?oldid=494026699"^^xsd:anyURI ;
           ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.A00300" .


