###  https://w3id.org/emmo#EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2
ns1:EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_32e701c0_a925_49df_9829_0931b8554807 ;
                                              rdfs:comment "The superclass for all classes of entities that have no proper parts of the same type of the whole."@en ,
                                                           "Fundamental(x) ≡ ∃φ[φ(x) ∧ ¬∃yRP⟨φ⟩(y, x)]" ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/structural#> ;
                                              rdfs:label "Fundamental"@en ;
                                              rdfs:seeAlso ns1:EMMO_bbca6dfa_7463_4e8d_8280_35862ff50ce0 ;
                                              skos:altLabel "Lifetime"@en ;
                                              skos:example """A marathon is an example of class whose individuals are always maximal since the criteria satisfied by a marathon 4D entity poses some constraints on its temporal and spatial extent.
On the contrary, the class for a generic running process does not necessarily impose maximality to its individuals. A running individual is maximal only when it extends in time for the minimum amount required to identify a running act, so every possible temporal part is always a non-running.
Following the two examples, a marathon individual is a maximal that can be decomposed into running intervals. The marathon class is a subclass of running."""@en ;
                                              skos:prefLabel "Fundamental"@en ;
                                              ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "Fundamental(x) ≡ ∃φ[φ(x) ∧ ¬∃yRP⟨φ⟩(y, x)]" ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The superclass for all classes of entities that have no proper parts of the same type of the whole."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2 ;
   owl:annotatedProperty skos:altLabel ;
   owl:annotatedTarget "Lifetime"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Middle English liftime, equivalent to life +‎ time."@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2 ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "Fundamental"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Latin fundamentum (“foundation”), from fundō (“to lay the foundation (of something), to found”), from fundus (“bottom”)."@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2 ;
   owl:annotatedProperty ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 ;
   owl:annotatedTarget "Fundamental(x) ≡ ∃φ[φ(x) ∧ ¬∃yRP⟨φ⟩(y, x)]" ;
   rdfs:seeAlso ns1:EMMO_6786b336_e982_4759_8dee_1905a4106591
 ] .


###  https://w3id.org/emmo#EMMO_57d977ab_0036_4779_b59a_e47620afdb9c
