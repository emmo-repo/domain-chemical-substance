   owl:annotatedProperty skos:altLabel ;
   owl:annotatedTarget "CausalChain"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Old French chaine, chaene (“chain”), from Latin catēna (“chain”)."@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360 ;
   owl:annotatedProperty skos:altLabel ;
   owl:annotatedTarget "Elementary"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Latin elementārius (“elementary”), from elementum (“one of the four elements of antiquity; fundamentals”)."@en
 ] .

[ rdf:type owl:Axiom ;
