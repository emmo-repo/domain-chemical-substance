                                              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits#> ;
                                              rdfs:label "ThermalTransmittanceUnit"@en ;
                                              skos:prefLabel "ThermalTransmittanceUnit"@en ;
