                                                              ] ;
                                              owl:disjointWith ns1:EMMO_700cd058_a54d_4104_97ab_887ad865409e ;
                                              rdfs:comment "A geometrical property of an area which reflects how its points are distributed with regard to an arbitrary axis."@en ;
