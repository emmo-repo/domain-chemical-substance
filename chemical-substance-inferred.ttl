###  https://w3id.org/emmo#EMMO_4b2c223f_89fb_4407_b1b6_24774b7fe770
ns1:EMMO_4b2c223f_89fb_4407_b1b6_24774b7fe770 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_9895a1b4_f0a5_4167_ac5e_97db40b8bfcc ,
