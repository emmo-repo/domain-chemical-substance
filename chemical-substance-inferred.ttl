   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Object that is processed with a machine" ;
   rdfs:seeAlso "DIN EN ISO 5349-2:2015-12"
 ] .

[ rdf:type owl:Axiom ;
