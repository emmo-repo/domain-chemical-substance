###  https://w3id.org/emmo#NewtonPerCoulomb
ns1:NewtonPerCoulomb rdf:type owl:Class ;
                     rdfs:subClassOf ns1:EMMO_1273eb34_de48_43a9_925f_104110469dd2 ,
                                     ns1:EMMO_ebf9a5c6_ca80_45d4_a991_24a1bf4b6720 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                       owl:hasValue "1.0"^^xsd:double
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                       owl:hasValue "0.0"^^xsd:double
                                     ] ;
                     rdfs:comment """Newton Per Coulomb ( N/C) is a unit in the category of Electric field strength. It is also known as newtons/coulomb. Newton Per Coulomb ( N/C) has a dimension of MLT-3I-1 where M is mass, L is length, T is time, and I is electric current. It essentially the same as the corresponding standard SI unit V/m.

-- QUDT"""@en ;
                     rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits#> ,
                                      "http://qudt.org/2.1/vocab/unit" ;
                     rdfs:label "NewtonPerCoulomb"@en ;
                     skos:altLabel "Newton per Coulomb"@en ;
                     skos:prefLabel "NewtonPerCoulomb"@en ;
                     ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/N-PER-C" ;
                     ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "N.C-1" ;
                     ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "N/C" ;
                     ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """Newton Per Coulomb ( N/C) is a unit in the category of Electric field strength. It is also known as newtons/coulomb. Newton Per Coulomb ( N/C) has a dimension of MLT-3I-1 where M is mass, L is length, T is time, and I is electric current. It essentially the same as the corresponding standard SI unit V/m.

-- QUDT"""@en .


