                                              rdfs:label "Language"@en ;
                                              skos:prefLabel "Language"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A language object is a discrete data entity respecting specific language syntactic rules (a well-formed formula)."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_d8d2144e_5c8d_455d_a643_5caf4d8d9df8 ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "Language"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Latin lingua (“tongue, speech, language”), from Old Latin dingua (“tongue”)."@en
 ] .


