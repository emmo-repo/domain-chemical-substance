###  https://w3id.org/emmo#AmperePerMetre
ns1:AmperePerMetre rdf:type owl:Class ;
                   rdfs:subClassOf ns1:EMMO_1273eb34_de48_43a9_925f_104110469dd2 ,
                                   ns1:EMMO_e6b83139_ba92_4fbd_a8b2_c8dde55844a1 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                     owl:hasValue "1.0"^^xsd:double
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                     owl:hasValue "0.0"^^xsd:double
                                   ] ;
                   rdfs:comment """ is the SI unit of magnetic field strength. One ampere per meter is equal to π/250 oersteds (12.566  371 millioersteds) in CGS units. The ampere per meter is also the SI unit of \"magnetization\" in the sense of magnetic dipole moment per unit volume; in this context 1 A/m = 0.001 emu per cubic centimeter.

-- QUDT"""@en ;
                   rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits#> ,
                                    "http://qudt.org/2.1/vocab/unit" ;
                   rdfs:label "AmperePerMetre"@en ;
                   skos:altLabel "Ampere per Metre"@en ;
                   skos:prefLabel "AmperePerMetre"@en ;
                   ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/A-PER-M" ;
                   ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "A.m-1" ,
                                                                 "A/m" ;
                   ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "A/m" ;
                   ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """ is the SI unit of magnetic field strength. One ampere per meter is equal to π/250 oersteds (12.566  371 millioersteds) in CGS units. The ampere per meter is also the SI unit of \"magnetization\" in the sense of magnetic dipole moment per unit volume; in this context 1 A/m = 0.001 emu per cubic centimeter.

-- QUDT"""@en .


