                                              owl:disjointWith ns1:EMMO_c9c8f824_9127_4f93_bc21_69fe78a7f6f2 ;
                                              owl:disjointUnionOf ( ns1:EMMO_15344998_4490_4b40_b242_c3d92e5cdc27
                                                                    ns1:EMMO_feb03a8a_bbb6_4918_a891_46713ef557f4
                                                                  ) ;
