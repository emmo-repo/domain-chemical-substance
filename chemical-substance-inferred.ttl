                           [ rdf:type owl:Restriction ;
                             owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                             owl:hasValue "Pa"
                           ] ;
           rdfs:comment "SI unit for pressure."@en ;
           rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
           rdfs:label "Pascal"@en ;
           skos:prefLabel "Pascal"@en ;
           schema:unitCode "PAL" ;
           ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/PA" ;
